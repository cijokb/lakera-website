---
const galleryItems = [
  {
    title: "The Main Dining Room",
    category: "Intimate Ambiance",
    desc: "Warm brass lighting, dark wood acoustics, and handcrafted rattan furnishings designed for leisurely multi-course dining.",
    image: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=800&q=80"
  },
  {
    title: "Live Porotta & Griddle Counter",
    category: "The Hearth",
    desc: "Watch our master parotta makers toss paper-thin dough and flash-roast fresh seafood on smoking cast iron.",
    image: "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80"
  },
  {
    title: "Private Dining Salon",
    category: "Family & VIP Banquets",
    desc: "A secluded sanctuary accommodating up to 24 guests, equipped with personalized multi-course tasting menus.",
    image: "https://images.unsplash.com/photo-1590846406792-0adc7f938f1d?auto=format&fit=crop&w=800&q=80"
  }
];
---

<section id="ambience" class="scroll-mt-20 py-20 lg:py-28 bg-[#f8faf8] dark:bg-[#060f09] border-t border-zinc-200 dark:border-[#278440]/25 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#278440]/30 dark:border-[#278440]/50 bg-white/90 dark:bg-[#0c1910]/90 px-3 py-1 shadow-sm mb-3">
        <img src="/images/lakera-logo-square.png" alt="La Kera Emblem" class="h-5 w-5 rounded-full object-cover border border-[#278440]" />
        <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#1e6933] dark:text-[#38b359]">The Hospitality</span>
      </div>
      <h2 class="mt-3 font-serif text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-5xl lg:text-6xl">
        Atmosphere & <span class="green-gradient-text italic font-normal">Dining Spaces</span>
      </h2>
      <p class="mt-4 text-pretty text-zinc-600 dark:text-zinc-300 text-sm sm:text-base font-light">
        Curated with understated coastal elegance, warm illumination matching our illuminated signboard, and the welcoming warmth of traditional Malabar homes.
      </p>
    </div>

    <!-- Gallery 3-Card Responsive Grid -->
    <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3">
      {galleryItems.map((item) => (
        <div class="card-luxury group relative overflow-hidden rounded-3xl transition-all duration-500 flex flex-col justify-between">
          <div class="relative h-64 sm:h-72 w-full overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-110 filter brightness-[0.85] group-hover:brightness-100"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent"></div>

            <div class="absolute top-3 left-3">
              <span class="rounded-full border border-[#278440]/50 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-[#38b359]">
                {item.category}
              </span>
            </div>

            <div class="absolute bottom-3 left-4 right-4">
              <h3 class="font-serif text-lg font-bold text-white group-hover:text-[#38b359] transition-colors">
                {item.title}
              </h3>
            </div>
          </div>

          <div class="p-5 flex-1 flex flex-col justify-between">
            <p class="text-xs text-zinc-600 dark:text-zinc-400 font-light leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
