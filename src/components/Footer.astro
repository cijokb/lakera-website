---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-800 bg-zinc-950 text-zinc-400 py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4 lg:gap-12">
      <!-- Brand & Tagline -->
      <div class="md:col-span-2">
        <a href="#" class="flex flex-col">
          <span class="font-serif text-2xl font-bold tracking-wider text-amber-500">
            LA KERA
          </span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-zinc-400">
            Coastal Kitchen & Dining
          </span>
        </a>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-zinc-400">
          Celebrating the rich coastal recipes of Malabar and Kerala. Slow-cooked seafood, wood-pressed coconut oil, stone-ground aromatics, and clay-pot slow braises.
        </p>
        <div class="mt-4 flex items-center gap-2 text-xs text-zinc-400">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span>Official Domain: <a href="https://lakera.co.in" class="text-amber-400 hover:underline">lakera.co.in</a></span>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-200">
          Navigation
        </h4>
        <ul class="mt-4 space-y-2.5 text-xs">
          <li>
            <a href="#menu" class="transition-colors hover:text-amber-400">Menu & Specialties</a>
          </li>
          <li>
            <a href="#story" class="transition-colors hover:text-amber-400">Our Heritage & Story</a>
          </li>
          <li>
            <a href="#location" class="transition-colors hover:text-amber-400">Location & Directions</a>
          </li>
          <li>
            <a href="#timings" class="transition-colors hover:text-amber-400">Operating Hours</a>
          </li>
        </ul>
      </div>

      <!-- Compliance & Standards -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-200">
          FSSAI & Standards
        </h4>
        <div class="mt-4 space-y-2 text-xs leading-relaxed text-zinc-400">
          <p>
            <strong class="text-zinc-300">FSSAI Registration:</strong><br />
            License No. <span class="font-mono text-zinc-300">10023042000000</span>
          </p>
          <p class="text-[11px] text-zinc-400">
            Strict adherence to hygiene, fresh non-frozen procurement, and food safety standards.
          </p>
          <p class="pt-2 text-[11px] text-zinc-400">
            Reservations & Desk: <br />
            <a href="tel:+919500978712" class="text-amber-400 font-mono hover:underline">+91 95009 78712</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between border-t border-zinc-900 pt-8 sm:flex-row gap-4">
      <p class="text-[11px] text-zinc-400">
        &copy; {currentYear} La Kera Restaurant (<a href="https://lakera.co.in" class="hover:text-zinc-400">lakera.co.in</a>). All rights reserved.
      </p>
      <p class="text-[11px] text-zinc-400">
        Crafted with pride for coastal food lovers.
      </p>
    </div>
  </div>
</footer>
