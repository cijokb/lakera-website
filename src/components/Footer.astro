---
import WhatsAppLogo from './icons/WhatsAppLogo.astro';
import SwiggyLogo from './icons/SwiggyLogo.astro';
import ZomatoLogo from './icons/ZomatoLogo.astro';

const currentYear = new Date().getFullYear();
const swiggyUrl = "https://www.swiggy.com/city/bangalore/erivum-puliyum-brookefields-aecs-layout-rest63059";
const zomatoUrl = "https://www.zomato.com/bangalore/erivum-puliyum-brookefield-bangalore";
---

<footer class="border-t border-zinc-200 dark:border-[#278440]/25 bg-[#f0f5f1] dark:bg-[#030805] text-zinc-600 dark:text-zinc-400 py-16 sm:py-20 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4 lg:gap-12">
      <!-- Brand & Tagline with Official Emblem -->
      <div class="md:col-span-2">
        <a href="#" class="flex items-center gap-3.5">
          <div class="h-12 w-12 rounded-full border-2 border-[#278440] overflow-hidden bg-[#278440] shadow-md shadow-[#278440]/30 flex-shrink-0">
            <img
              src="/images/lakera-logo-square.png"
              alt="La Kera Restaurant Logo"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="flex flex-col">
            <span class="font-serif text-2xl font-bold tracking-wider text-zinc-900 dark:text-white">
              LA KERA
            </span>
            <span class="text-[9px] font-semibold uppercase tracking-[0.24em] text-[#1e6933] dark:text-[#38b359]">
              The Real Taste of Kerala
            </span>
          </div>
        </a>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-zinc-600 dark:text-zinc-400 font-light">
          Celebrating the authentic culinary heritage of Kerala. Savor traditional Malabar dum biryanis, slow-cooked clay pot meen curries, and banana-leaf roasted coastal seafood at our Seegehalli, Bengaluru dining hall.
        </p>
        <div class="mt-4 text-xs text-zinc-600 dark:text-zinc-400 space-y-1">
          <p class="text-zinc-900 dark:text-zinc-200 font-medium">3rd Floor, 120/1, Udbav Channe Gowda Complex,</p>
          <p>SH 35, Next to NITESH FOREST HILLS, Seegehalli, Bengaluru 560115</p>
        </div>
        <div class="mt-4 flex items-center gap-2 text-xs text-zinc-600 dark:text-zinc-400">
          <span class="h-2 w-2 rounded-full bg-[#278440]"></span>
          <span>Official Domain: <a href="https://lakera.co.in" class="text-[#1e6933] dark:text-[#38b359] hover:underline font-medium">lakera.co.in</a></span>
        </div>
      </div>

      <!-- Quick Navigation & Delivery -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-zinc-900 dark:text-white">
          Order Online
        </h4>
        <div class="mt-4 space-y-2.5 text-xs">
          <a
            href={swiggyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 transition-colors font-medium"
          >
            <SwiggyLogo class="h-3.5 w-3.5" />
            <span>Order on Swiggy</span>
          </a>
          <a
            href={zomatoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-rose-600 dark:text-rose-400 hover:text-rose-700 dark:hover:text-rose-300 transition-colors font-medium"
          >
            <ZomatoLogo class="h-3.5 w-3.5" />
            <span>Order on Zomato</span>
          </a>
          <a
            href="https://wa.me/919500978712"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-[#1e6933] dark:text-[#38b359] hover:text-[#278440] dark:hover:text-[#52c972] transition-colors font-medium"
          >
            <WhatsAppLogo class="h-3.5 w-3.5" />
            <span>WhatsApp Takeaway</span>
          </a>
        </div>

        <h4 class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-zinc-900 dark:text-white">
          Navigation
        </h4>
        <ul class="mt-3 space-y-2 text-xs">
          <li>
            <a href="#signatures" class="transition-colors hover:text-[#1e6933] dark:hover:text-[#38b359]">Chef's Signatures</a>
          </li>
          <li>
            <a href="#menu" class="transition-colors hover:text-[#1e6933] dark:hover:text-[#38b359]">A La Carte Menu</a>
          </li>
          <li>
            <a href="#story" class="transition-colors hover:text-[#1e6933] dark:hover:text-[#38b359]">Our Heritage & Mascot</a>
          </li>
          <li>
            <a href="#location" class="transition-colors hover:text-[#1e6933] dark:hover:text-[#38b359]">Directions & Hours</a>
          </li>
        </ul>
      </div>

      <!-- Compliance & Standards -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-zinc-900 dark:text-white">
          FSSAI & Desk
        </h4>
        <div class="mt-4 space-y-2 text-xs leading-relaxed text-zinc-600 dark:text-zinc-400 font-light">
          <p>
            <strong class="text-zinc-900 dark:text-zinc-200 font-normal">FSSAI License:</strong><br />
            Reg. No. <span class="font-mono text-[#1e6933] dark:text-[#38b359] font-medium">10023042000000</span>
          </p>
          <p class="text-[11px] text-zinc-500 dark:text-zinc-400">
            Strict adherence to hygiene, non-frozen procurement, and food safety standards.
          </p>
          <p class="pt-2 text-[11px] text-zinc-500 dark:text-zinc-400">
            Helpline & Private Dining: <br />
            <a href="tel:+919500978712" class="text-[#1e6933] dark:text-[#38b359] font-mono hover:underline font-semibold">+91 95009 78712</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-14 flex flex-col items-center justify-between border-t border-zinc-200 dark:border-[#278440]/20 pt-8 sm:flex-row gap-4">
      <p class="text-[11px] text-zinc-500 dark:text-zinc-400">
        &copy; {currentYear} La Kera Restaurant (<a href="https://lakera.co.in" class="hover:text-zinc-700 dark:hover:text-zinc-300">lakera.co.in</a>). All rights reserved.
      </p>
      <p class="text-[11px] text-[#1e6933] dark:text-[#38b359] font-medium">
        The Real Taste of Kerala • Seegehalli, Bengaluru
      </p>
    </div>
  </div>
</footer>
