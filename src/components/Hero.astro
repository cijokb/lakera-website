---
import WhatsAppLogo from './icons/WhatsAppLogo.astro';
import SwiggyLogo from './icons/SwiggyLogo.astro';
import ZomatoLogo from './icons/ZomatoLogo.astro';

const reservationText = encodeURIComponent(
  "Hello La Kera! I'd like to reserve a table at your Seegehalli, Bengaluru restaurant."
);
const whatsappUrl = `https://wa.me/919500978712?text=${reservationText}`;
const swiggyUrl = "https://www.swiggy.com/city/bangalore/erivum-puliyum-brookefields-aecs-layout-rest63059";
const zomatoUrl = "https://www.zomato.com/bangalore/erivum-puliyum-brookefield-bangalore";
---

<section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden py-16 sm:py-20 lg:py-28">
  <!-- Atmospheric Background Image with Brand Foliage Vignette -->
  <div class="absolute inset-0 -z-20 overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1920&q=85"
      alt="La Kera Kerala Dining Ambiance"
      class="h-full w-full object-cover object-center scale-105 filter brightness-[0.7] dark:brightness-[0.20] contrast-[1.1] dark:contrast-[1.2] transition-all duration-300"
      fetchpriority="high"
    />
    <!-- Gradient Overlays for Readability & Depth in Light & Dark Mode -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/95 via-white/80 to-[#f8faf8] dark:from-[#060f09]/95 dark:via-[#060f09]/75 dark:to-[#060f09] transition-colors duration-300"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(248,250,248,0.7)_80%)] dark:bg-[radial-gradient(ellipse_at_center,transparent_0%,#060f09_80%)] transition-colors duration-300"></div>
  </div>

  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8 relative z-10">
    <!-- Official Mascot Emblem Presentation -->
    <div class="mx-auto mb-6 flex justify-center">
      <div class="relative group">
        <div class="absolute -inset-2 rounded-full bg-gradient-to-tr from-[#278440]/50 via-[#3A6CB4]/30 to-transparent blur-xl opacity-85 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative h-28 w-28 sm:h-36 sm:w-36 rounded-full border-2 border-[#278440] p-0.5 bg-[#278440] shadow-2xl shadow-[#278440]/40 overflow-hidden transition-transform group-hover:scale-105">
          <img
            src="/images/lakera-logo-square.png"
            alt="La Kera Restaurant - The Real Taste of Kerala Mascot Emblem"
            class="h-full w-full rounded-full object-cover"
          />
        </div>
      </div>
    </div>

    <!-- Heritage Ribbon & Live Indicator -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#278440]/30 dark:border-[#278440]/50 bg-white/90 dark:bg-[#0c1910]/90 px-4 py-1.5 text-xs font-semibold tracking-wider text-[#1e6933] dark:text-[#38b359] shadow-sm backdrop-blur-md">
        <span class="uppercase tracking-widest font-bold">The Real Taste of Kerala</span>
        <span class="text-zinc-400 dark:text-zinc-600">•</span>
        <span class="text-zinc-700 dark:text-zinc-300">Seegehalli, Bengaluru</span>
      </div>

      <div class="inline-flex items-center gap-2 rounded-full border border-[#3A6CB4]/30 dark:border-[#3A6CB4]/40 bg-blue-50/90 dark:bg-[#3A6CB4]/15 px-3.5 py-1.5 text-xs font-medium text-[#24529a] dark:text-[#7bb0ff] shadow-sm backdrop-blur-md">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#5289db] opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#3A6CB4]"></span>
        </span>
        <span>Open Daily • 11:30 AM – 11:00 PM</span>
      </div>
    </div>

    <!-- Main Headline with Clean Display Typography -->
    <h1 class="mt-6 font-serif text-4xl font-black tracking-tight text-zinc-900 dark:text-white sm:text-6xl md:text-7xl lg:text-8xl leading-[1.08]">
      Authentic <span class="green-gradient-text italic font-normal">Kerala & Coastal</span> Dining
    </h1>

    <!-- Elevated Subtitle -->
    <p class="mx-auto mt-5 max-w-3xl text-pretty text-base text-zinc-700 dark:text-zinc-300 sm:text-lg md:text-xl font-light leading-relaxed">
      Welcome to <strong class="text-zinc-900 dark:text-white font-medium">La Kera Restaurant</strong> at Seegehalli, Bengaluru. Slow-cooked coastal seafood, clay-pot meen curries, and fragrant Thalassery dum biryanis—served piping-hot with the authentic warmth of Kerala hospitality.
    </p>

    <!-- Social Proof Rating Pill -->
    <div class="mt-5 flex items-center justify-center gap-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-400">
      <span class="flex text-[#cfa86e]">
        ★ ★ ★ ★ ★
      </span>
      <span class="font-semibold text-zinc-800 dark:text-zinc-200">4.9 / 5</span>
      <span class="text-zinc-400 dark:text-zinc-500">•</span>
      <span class="text-zinc-600 dark:text-zinc-400">Over 1,400+ Happy Food Lovers in Bengaluru</span>
    </div>

    <!-- Primary Action Buttons -->
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-3 rounded-full bg-gradient-to-r from-[#278440] via-[#2f9c4d] to-[#1e6933] px-8 py-4 text-xs sm:text-sm font-bold uppercase tracking-wider text-white shadow-xl shadow-[#278440]/30 transition-all hover:scale-105 hover:shadow-2xl hover:shadow-[#278440]/50 active:scale-95 sm:w-auto"
      >
        <WhatsAppLogo class="h-4 w-4" />
        <span>Book Table via WhatsApp</span>
      </a>

      <a
        href="#signatures"
        class="inline-flex w-full items-center justify-center gap-2.5 rounded-full border border-[#3A6CB4]/40 dark:border-[#3A6CB4]/50 bg-white/90 dark:bg-[#0c1910]/80 px-8 py-4 text-xs sm:text-sm font-bold uppercase tracking-wider text-[#24529a] dark:text-[#8cb8ff] shadow-sm backdrop-blur-md transition-all hover:border-[#3A6CB4] hover:bg-blue-50 dark:hover:bg-[#3A6CB4]/15 hover:text-[#1c3f76] dark:hover:text-white active:scale-95 sm:w-auto"
      >
        <span>Explore Signatures</span>
        <svg class="h-4 w-4 text-[#3A6CB4] dark:text-[#5d93e6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

    <!-- Quick Online Food Delivery Bar (Swiggy & Zomato) -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <span class="text-xs uppercase font-bold tracking-wider text-zinc-600 dark:text-zinc-400">Order Online Delivery:</span>
      
      <!-- Swiggy Button -->
      <a
        href={swiggyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 rounded-full border border-orange-500/40 dark:border-orange-500/50 bg-orange-50 dark:bg-[#fc8019]/15 px-5 py-2 text-xs font-bold uppercase tracking-wider text-orange-700 dark:text-orange-300 shadow-sm transition-all hover:scale-105 hover:bg-[#fc8019] hover:text-white active:scale-95"
      >
        <SwiggyLogo class="h-4 w-4 text-[#fc8019] group-hover:text-white transition-colors" />
        <span>Order on Swiggy</span>
      </a>

      <!-- Zomato Button -->
      <a
        href={zomatoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 rounded-full border border-rose-500/40 dark:border-rose-500/50 bg-rose-50 dark:bg-[#e23744]/15 px-5 py-2 text-xs font-bold uppercase tracking-wider text-rose-700 dark:text-rose-300 shadow-sm transition-all hover:scale-105 hover:bg-[#e23744] hover:text-white active:scale-95"
      >
        <ZomatoLogo class="h-4 w-4 text-[#e23744] group-hover:text-white transition-colors" />
        <span>Order on Zomato</span>
      </a>
    </div>

    <!-- Heritage Highlights Banner with Mascot Cloche Motif -->
    <div class="mt-14 grid grid-cols-2 gap-3 border-t border-zinc-200 dark:border-[#278440]/25 pt-8 sm:grid-cols-4 sm:gap-4">
      <div class="card-luxury rounded-2xl p-4 text-center">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-[#278440] dark:text-[#38b359]">Steaming Fresh</span>
        <p class="mt-1 font-serif text-base font-bold text-zinc-900 dark:text-white">Cloche to Table</p>
      </div>
      <div class="card-luxury rounded-2xl p-4 text-center">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-[#278440] dark:text-[#38b359]">Harbor Catch</span>
        <p class="mt-1 font-serif text-base font-bold text-zinc-900 dark:text-white">100% Sea Fresh</p>
      </div>
      <div class="card-luxury rounded-2xl p-4 text-center">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-[#278440] dark:text-[#38b359]">Manchatti</span>
        <p class="mt-1 font-serif text-base font-bold text-zinc-900 dark:text-white">Clay-Pot Braised</p>
      </div>
      <div class="card-luxury rounded-2xl p-4 text-center">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-[#3A6CB4] dark:text-[#5d93e6]">Eco Packaging</span>
        <p class="mt-1 font-serif text-base font-bold text-orange-600 dark:text-orange-400">Swiggy & Zomato</p>
      </div>
    </div>
  </div>
</section>
