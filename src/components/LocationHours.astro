---
const whatsappDeskUrl = `https://wa.me/919500978712?text=${encodeURIComponent(
  "Hello La Kera! I have an inquiry regarding dining reservations / bulk catering."
)}`;
---

<section id="location" class="scroll-mt-20 py-16 sm:py-24 border-t border-zinc-850">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-amber-500">Visit & Connect</span>
      <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
        Location, Timings & Contact
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-pretty text-zinc-400 text-sm sm:text-base">
        Join us for an intimate coastal dining experience or reach out directly to reserve our private dining room and outdoor catering services.
      </p>
    </div>

    <!-- 3-Column Responsive Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      <!-- Column 1: Address & Directions -->
      <div class="flex flex-col justify-between rounded-2xl border border-zinc-800 bg-zinc-900/70 p-6 sm:p-8 backdrop-blur-sm">
        <div>
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/10 text-amber-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>

          <h3 class="mt-5 text-xl font-bold text-white">Address & Dining Hall</h3>
          <p class="mt-3 text-sm leading-relaxed text-zinc-300">
            <strong class="text-white font-medium">La Kera Restaurant</strong><br />
            Coastal Kitchen & Private Dining<br />
            Main Coastal Road, Near Harborside<br />
            Serving Authentic Malabar Flavours
          </p>
          <div class="mt-4 inline-flex items-center gap-1.5 text-xs text-amber-400/90">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Valet & Street Parking Available</span>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-800">
          <a
            href="https://maps.google.com/?q=La+Kera+Restaurant"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-zinc-800 px-4 py-2.5 text-xs font-semibold text-zinc-200 transition-all hover:bg-zinc-700 hover:text-white"
          >
            <span>Get Directions on Google Maps</span>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Service Hours (with id="timings" anchor) -->
      <div id="timings" class="scroll-mt-24 flex flex-col justify-between rounded-2xl border border-amber-500/30 bg-zinc-900/90 p-6 sm:p-8 backdrop-blur-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 h-24 w-24 bg-amber-500/10 blur-2xl pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/10 text-amber-400">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="rounded-full border border-emerald-500/30 bg-emerald-950/40 px-3 py-1 text-[11px] font-semibold text-emerald-400">
              Open All 7 Days
            </span>
          </div>

          <h3 class="mt-5 text-xl font-bold text-white">Service Hours</h3>

          <div class="mt-4 space-y-4">
            <div class="rounded-xl bg-zinc-950/60 p-3.5 border border-zinc-800/80">
              <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-amber-400">
                <span>Lunch Session</span>
                <span class="text-zinc-400">Fresh Catch</span>
              </div>
              <p class="mt-1 text-base font-bold text-white">11:30 AM – 3:30 PM</p>
              <p class="text-[11px] text-zinc-400 mt-0.5">Last order: 3:00 PM</p>
            </div>

            <div class="rounded-xl bg-zinc-950/60 p-3.5 border border-zinc-800/80">
              <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-amber-400">
                <span>Dinner Session</span>
                <span class="text-zinc-400">Dum Biryanis</span>
              </div>
              <p class="mt-1 text-base font-bold text-white">7:00 PM – 11:00 PM</p>
              <p class="text-[11px] text-zinc-400 mt-0.5">Last order: 10:30 PM</p>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-800/80">
          <p class="text-center text-xs text-zinc-400">
            Reservations recommended for dinner and weekend peak hours.
          </p>
        </div>
      </div>

      <!-- Column 3: Direct Contact & Catering -->
      <div class="flex flex-col justify-between rounded-2xl border border-zinc-800 bg-zinc-900/70 p-6 sm:p-8 backdrop-blur-sm">
        <div>
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>

          <h3 class="mt-5 text-xl font-bold text-white">Contact & Catering</h3>
          <p class="mt-2 text-sm text-zinc-300 leading-relaxed">
            Call our hospitality desk for reservations, takeaway orders, or private banquet bookings.
          </p>

          <div class="mt-4 rounded-xl bg-zinc-950/60 p-3.5 border border-zinc-800/80">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-zinc-400">Direct Helpline</span>
            <a
              href="tel:+919500978712"
              class="mt-1 block text-lg font-bold text-amber-400 hover:text-amber-300 font-mono"
            >
              +91 95009 78712
            </a>
          </div>

          <p class="mt-4 text-xs text-zinc-400">
            <strong class="text-zinc-200">Outdoor Catering:</strong> We curate authentic Sadhya spreads, live Porotta counters, and seafood grills for weddings and corporate gatherings.
          </p>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-800">
          <a
            href={whatsappDeskUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-md shadow-emerald-950 transition-all hover:bg-emerald-500 active:scale-98"
          >
            <span>Message on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
