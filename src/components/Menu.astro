---
import menuItems from '../data/menu.json';

const categories = [
  { id: 'all', label: 'All Items' },
  { id: 'Coastal Seafood', label: 'Coastal Seafood' },
  { id: 'Biryani & Rice', label: 'Biryani & Rice' },
  { id: 'Grills & Curries', label: 'Grills & Curries' },
  { id: 'Breads & Accompaniments', label: 'Breads & Accompaniments' },
  { id: 'Desserts & Drinks', label: 'Desserts & Drinks' },
];

function getWhatsAppOrderLink(name: string, price: number) {
  const text = encodeURIComponent(
    `Hello La Kera! I'd like to order "${name}" (₹${price}). Please confirm availability and preparation time.`
  );
  return `https://wa.me/919500978712?text=${text}`;
}
---

<section id="menu" class="scroll-mt-20 py-16 sm:py-24 border-t border-zinc-850">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-amber-500">Curated Offerings</span>
      <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
        The Coastal Menu
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-pretty text-zinc-400 text-sm sm:text-base">
        Slow-cooked delicacies prepared fresh on order using cold-pressed coconut oil, fresh coastal seafood, and hand-pounded spices.
      </p>
    </div>

    <!-- Category Filter Tabs & Veg Toggle -->
    <div class="mt-10 flex flex-col items-center gap-4">
      <!-- Tabs (horizontally scrollable on mobile) -->
      <div class="no-scrollbar flex w-full max-w-4xl items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-2 px-1">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-tab flex-shrink-0 rounded-full px-4 py-2 text-xs sm:text-sm font-medium transition-all ${
              idx === 0
                ? 'active bg-amber-500 text-zinc-950 shadow-md font-semibold'
                : 'bg-zinc-900/90 text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200 border border-zinc-800'
            }`}
            data-target-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Quick Veg Only Toggle -->
      <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/80 px-3.5 py-1.5 text-xs text-zinc-300 select-none hover:border-zinc-700">
        <input type="checkbox" id="veg-only-toggle" class="sr-only peer" />
        <div class="relative h-4 w-7 rounded-full bg-zinc-700 peer peer-checked:bg-emerald-500 transition-colors after:absolute after:top-[2px] after:left-[2px] after:h-3 after:w-3 after:rounded-full after:bg-white after:transition-all peer-checked:after:translate-x-3"></div>
        <span class="flex items-center gap-1.5">
          <span class="inline-flex h-3 w-3 items-center justify-center border border-emerald-500 p-[1px]">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          </span>
          <span>Veg Only</span>
        </span>
      </label>
    </div>

    <!-- Menu Items Grid -->
    <div id="menu-grid" class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">
      {menuItems.map((item) => (
        <article
          class="menu-item group flex flex-col justify-between rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-5 backdrop-blur-sm transition-all duration-200 hover:-translate-y-1 hover:border-zinc-700 hover:bg-zinc-900 hover:shadow-xl"
          data-category={item.category}
          data-is-veg={item.isVeg ? 'true' : 'false'}
        >
          <div>
            <!-- Top bar: FSSAI Indicator & Badges -->
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <!-- FSSAI Veg / Non-Veg Standard Dot Icon -->
                {item.isVeg ? (
                  <span class="inline-flex h-4 w-4 items-center justify-center rounded-[2px] border border-emerald-500 bg-emerald-950/40 p-[2px]" title="Vegetarian">
                    <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                  </span>
                ) : (
                  <span class="inline-flex h-4 w-4 items-center justify-center rounded-[2px] border border-rose-600 bg-rose-950/40 p-[2px]" title="Non-Vegetarian">
                    <span class="h-2 w-2 rounded-full bg-rose-600"></span>
                  </span>
                )}
                <span class="text-[11px] font-medium tracking-wide text-zinc-400">
                  {item.category}
                </span>
              </div>

              {item.badge && (
                <span class="rounded-md border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-amber-300">
                  {item.badge}
                </span>
              )}
            </div>

            <!-- Item Name -->
            <h3 class="mt-3 text-lg font-bold text-zinc-100 group-hover:text-amber-400 transition-colors">
              {item.name}
            </h3>

            <!-- Item Description -->
            <p class="mt-2 text-xs leading-relaxed text-zinc-400">
              {item.desc}
            </p>
          </div>

          <!-- Bottom bar: Price & Quick WhatsApp Order CTA -->
          <div class="mt-5 flex items-center justify-between border-t border-zinc-800/70 pt-4">
            <span class="font-mono text-xl font-bold text-amber-400">
              ₹{item.price}
            </span>

            <a
              href={getWhatsAppOrderLink(item.name, item.price)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-emerald-400 transition-all hover:border-emerald-500 hover:bg-emerald-500 hover:text-zinc-950 active:scale-95"
              aria-label={`Quick Order ${item.name} via WhatsApp`}
            >
              <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.449.742.964 1.201.662.591 1.221.774 1.394.861.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.203.043.072.043.419-.101.824z"/>
              </svg>
              <span>Quick Order</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty state message if veg filter yields zero in a category -->
    <div id="no-items-message" class="hidden py-12 text-center">
      <p class="text-sm text-zinc-400">No dishes match the selected filter combination.</p>
    </div>
  </div>
</section>

<script>
  function setupMenuFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
    const items = document.querySelectorAll<HTMLElement>('.menu-item');
    const vegToggle = document.getElementById('veg-only-toggle') as HTMLInputElement | null;
    const noItemsMsg = document.getElementById('no-items-message');

    let currentCategory = 'all';
    let vegOnly = false;

    function filterItems() {
      let visibleCount = 0;

      items.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        const itemIsVeg = item.getAttribute('data-is-veg') === 'true';

        const matchesCategory = currentCategory === 'all' || itemCategory === currentCategory;
        const matchesVeg = !vegOnly || itemIsVeg;

        if (matchesCategory && matchesVeg) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (noItemsMsg) {
        if (visibleCount === 0) {
          noItemsMsg.classList.remove('hidden');
        } else {
          noItemsMsg.classList.add('hidden');
        }
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active', 'bg-amber-500', 'text-zinc-950', 'shadow-md', 'font-semibold');
          t.classList.add('bg-zinc-900/90', 'text-zinc-400', 'border', 'border-zinc-800');
        });

        tab.classList.add('active', 'bg-amber-500', 'text-zinc-950', 'shadow-md', 'font-semibold');
        tab.classList.remove('bg-zinc-900/90', 'text-zinc-400', 'border', 'border-zinc-800');

        currentCategory = tab.getAttribute('data-target-category') || 'all';
        filterItems();
      });
    });

    if (vegToggle) {
      vegToggle.addEventListener('change', () => {
        vegOnly = vegToggle.checked;
        filterItems();
      });
    }
  }

  // Initialize filters
  setupMenuFilters();
</script>
