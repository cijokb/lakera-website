---
import SwiggyLogo from './icons/SwiggyLogo.astro';
import ZomatoLogo from './icons/ZomatoLogo.astro';
import WhatsAppLogo from './icons/WhatsAppLogo.astro';

const reservationText = encodeURIComponent("Hello La Kera, I would like to reserve a dining table.");
const whatsappUrl = `https://wa.me/919500978712?text=${reservationText}`;
const swiggyUrl = "https://www.swiggy.com/city/bangalore/erivum-puliyum-brookefields-aecs-layout-rest63059";
const zomatoUrl = "https://www.zomato.com/bangalore/erivum-puliyum-brookefield-bangalore";
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-200/80 dark:border-[#278440]/25 bg-white/90 dark:bg-[#060f09]/95 backdrop-blur-md transition-all duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2.5 sm:px-6 lg:px-8">
    <!-- Brand Logo with Official Mascot Emblem -->
    <a href="#" class="group flex items-center gap-3 focus:outline-none" aria-label="La Kera Restaurant Home">
      <div class="relative flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full border-2 border-[#278440] bg-[#278440] shadow-md shadow-[#278440]/25 overflow-hidden transition-transform group-hover:scale-105">
        <img
          src="/images/lakera-logo-square.png"
          alt="La Kera Restaurant Logo"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="flex flex-col">
        <span class="font-serif text-2xl font-bold tracking-wider text-zinc-900 dark:text-white transition-all group-hover:text-[#278440] dark:group-hover:text-[#38b359] sm:text-3xl">
          LA KERA
        </span>
        <span class="text-[9px] font-semibold uppercase tracking-[0.24em] text-[#278440] dark:text-[#38b359]">
          The Real Taste of Kerala
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary Navigation">
      <a href="#signatures" class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 transition-colors hover:text-[#278440] dark:hover:text-[#38b359]">
        Signatures
      </a>
      <a href="#menu" class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 transition-colors hover:text-[#278440] dark:hover:text-[#38b359]">
        The Menu
      </a>
      <a href="#story" class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 transition-colors hover:text-[#278440] dark:hover:text-[#38b359]">
        Our Heritage & Story
      </a>
      <a href="#ambience" class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 transition-colors hover:text-[#278440] dark:hover:text-[#38b359]">
        Ambiance
      </a>
      <a href="#location" class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 transition-colors hover:text-[#278440] dark:hover:text-[#38b359]">
        Seegehalli, Bengaluru
      </a>
    </nav>

    <!-- Header Delivery & Reservation CTAs + Theme Switcher -->
    <div class="hidden items-center gap-2.5 sm:flex">
      <!-- Theme Switcher Button -->
      <button
        type="button"
        class="theme-toggle-btn inline-flex h-8 w-8 items-center justify-center rounded-full border border-zinc-300 dark:border-[#278440]/40 bg-zinc-100 dark:bg-[#0c1910] text-zinc-700 dark:text-zinc-200 shadow-sm transition-all hover:scale-105 hover:border-[#278440] focus:outline-none"
        aria-label="Toggle light or dark theme"
        title="Switch theme"
      >
        <!-- Sun icon (visible in dark mode) -->
        <svg class="h-4 w-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (visible in light mode) -->
        <svg class="h-4 w-4 block dark:hidden text-[#278440]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Swiggy -->
      <a
        href={swiggyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full border border-orange-500/40 bg-orange-500/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-orange-600 dark:text-orange-400 transition-all hover:bg-orange-500 hover:text-white active:scale-95"
        title="Order on Swiggy"
      >
        <SwiggyLogo class="h-4 w-4" />
        <span>Swiggy</span>
      </a>

      <!-- Zomato -->
      <a
        href={zomatoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full border border-rose-500/40 bg-rose-500/10 px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 transition-all hover:bg-rose-600 hover:text-white active:scale-95"
        title="Order on Zomato"
      >
        <ZomatoLogo class="h-4 w-4" />
        <span>Zomato</span>
      </a>

      <!-- WhatsApp Reservation -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full border border-[#278440] bg-gradient-to-r from-[#278440] to-[#1e6933] px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-[#278440]/30 transition-all hover:brightness-110 active:scale-95"
      >
        <WhatsAppLogo class="h-3.5 w-3.5" />
        <span>Reserve</span>
      </a>
    </div>

    <!-- Mobile Hamburger & Actions Button -->
    <div class="flex items-center gap-2 lg:hidden">
      <!-- Mobile Theme Switcher -->
      <button
        type="button"
        class="theme-toggle-btn inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-300 dark:border-[#278440]/40 bg-zinc-100 dark:bg-[#0c1910] text-zinc-700 dark:text-zinc-200"
        aria-label="Toggle light or dark theme"
      >
        <svg class="h-4 w-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="h-4 w-4 block dark:hidden text-[#278440]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-lg border border-[#278440]/60 bg-[#278440]/10 dark:bg-[#278440]/20 p-2 text-[#278440] dark:text-[#38b359]"
        aria-label="Reserve a table on WhatsApp"
      >
        <WhatsAppLogo class="h-5 w-5" />
      </a>

      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex items-center justify-center rounded-lg border border-zinc-300 dark:border-[#278440]/30 bg-zinc-100 dark:bg-[#0c1910] p-2 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white focus:outline-none"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <svg id="hamburger-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden border-b border-zinc-200 dark:border-[#278440]/20 bg-white/98 dark:bg-[#060f09]/98 px-5 pt-3 pb-8 lg:hidden">
    <div class="flex flex-col space-y-3 pt-2">
      <a href="#signatures" class="mobile-nav-link rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-[#0c1910] hover:text-[#278440] dark:hover:text-[#38b359]">
        Chef's Signatures
      </a>
      <a href="#menu" class="mobile-nav-link rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-[#0c1910] hover:text-[#278440] dark:hover:text-[#38b359]">
        The Full Menu
      </a>
      <a href="#story" class="mobile-nav-link rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-[#0c1910] hover:text-[#278440] dark:hover:text-[#38b359]">
        Our Heritage & Story
      </a>
      <a href="#ambience" class="mobile-nav-link rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-[#0c1910] hover:text-[#278440] dark:hover:text-[#38b359]">
        Ambiance
      </a>
      <a href="#location" class="mobile-nav-link rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-[#0c1910] hover:text-[#278440] dark:hover:text-[#38b359]">
        Location: Seegehalli, Bengaluru
      </a>

      <!-- Mobile Delivery App Links with Official Logos -->
      <div class="pt-3 border-t border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5">
        <span class="text-[10px] uppercase font-bold tracking-wider text-zinc-500 dark:text-zinc-400">Order Online Delivery:</span>
        <div class="grid grid-cols-2 gap-2">
          <a
            href={swiggyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl border border-orange-500/40 bg-orange-500/10 py-2.5 text-xs font-bold uppercase text-orange-600 dark:text-orange-400 hover:bg-orange-500 hover:text-white"
          >
            <SwiggyLogo class="h-4 w-4" />
            <span>Swiggy</span>
          </a>
          <a
            href={zomatoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl border border-rose-500/40 bg-rose-500/10 py-2.5 text-xs font-bold uppercase text-rose-600 dark:text-rose-400 hover:bg-rose-600 hover:text-white"
          >
            <ZomatoLogo class="h-4 w-4" />
            <span>Zomato</span>
          </a>
        </div>
      </div>

      <div class="pt-2">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#278440] via-[#2f9c4d] to-[#1e6933] py-3 text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-[#278440]/30"
        >
          <WhatsAppLogo class="h-4 w-4" />
          <span>Book a Table via WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (button && menu && hamburgerIcon && closeIcon) {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }

  // Dual Theme Toggle Handler
  const toggleBtns = document.querySelectorAll('.theme-toggle-btn');
  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('lakera-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('lakera-theme', 'dark');
      }
    });
  });
</script>
