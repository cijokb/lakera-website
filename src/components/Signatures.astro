---
import WhatsAppLogo from './icons/WhatsAppLogo.astro';

const signatures = [
  {
    id: "karimeen-pollichathu",
    title: "Karimeen Pollichathu",
    subtitle: "Banana Leaf Smoked Pearl Spot",
    desc: "Whole pearl spot fish steeped in hand-ground shallot masala, wrapped in smoked banana leaf and griddle-roasted to flaking perfection.",
    price: 540,
    badge: "Chef's Masterpiece",
    image: "https://images.unsplash.com/photo-1552611052-33e04de081de?auto=format&fit=crop&w=800&q=80",
    tags: ["Fresh Backwater Catch", "Charred Banana Leaf", "Medium Spiced"],
    orderText: "Hello La Kera! I would like to reserve/order your signature Karimeen Pollichathu (₹540)."
  },
  {
    id: "prawns-ghee-roast",
    title: "Tiger Prawns Ghee Roast",
    subtitle: "Kundapura Artisanal Pan Roast",
    desc: "Plump Arabian Sea tiger prawns simmered in fiery, tangy Byadgi chili paste, rich clarified butter, and crispy fried curry leaves.",
    price: 490,
    badge: "Bestseller",
    image: "https://images.unsplash.com/photo-1559847844-5315695dadae?auto=format&fit=crop&w=800&q=80",
    tags: ["Ocean Prawns", "Artisanal Ghee", "Tellicherry Pepper"],
    orderText: "Hello La Kera! I would like to reserve/order your signature Tiger Prawns Ghee Roast (₹490)."
  },
  {
    id: "thalassery-mutton-biryani",
    title: "Thalassery Mutton Dum Biryani",
    subtitle: "Heirloom Malabar Dum Feasts",
    desc: "Aged miniature Kaima grain layered with fall-off-the-bone hill mutton, fragrant aromatics, golden ghee, sultanas, and fried shallots.",
    price: 480,
    badge: "Heritage Icon",
    image: "https://images.unsplash.com/photo-1589301760014-d929f3979dbc?auto=format&fit=crop&w=800&q=80",
    tags: ["Short-Grain Kaima", "Traditional Dum", "Hill Mutton"],
    orderText: "Hello La Kera! I would like to reserve/order your signature Thalassery Mutton Dum Biryani (₹480)."
  },
  {
    id: "alleppey-fish-curry",
    title: "Alleppey Meen Curry",
    subtitle: "Earthen Clay Pot (Manchatti) Simmer",
    desc: "Fresh ocean catch gently stewed in a velvet reduction of cold-pressed coconut milk, fresh ginger, slit green chilies, and raw sour mango.",
    price: 460,
    badge: "Clay Pot Classic",
    image: "https://images.unsplash.com/photo-1565557623262-b51c2513a641?auto=format&fit=crop&w=800&q=80",
    tags: ["Raw Mango", "Fresh Coconut Milk", "Porous Clay Pot"],
    orderText: "Hello La Kera! I would like to reserve/order your signature Alleppey Meen Curry (₹460)."
  }
];

function getWhatsAppUrl(text: string) {
  return `https://wa.me/919500978712?text=${encodeURIComponent(text)}`;
}
---

<section id="signatures" class="scroll-mt-20 py-20 lg:py-28 bg-[#f8faf8] dark:bg-[#060f09] border-t border-zinc-200 dark:border-[#278440]/25 relative transition-colors duration-300">
  <!-- Subtle decorative ambient light -->
  <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-96 w-full max-w-7xl bg-radial-gradient from-[#278440]/15 to-transparent blur-3xl opacity-50"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header with Brand Flourish & Emblem -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#278440]/30 dark:border-[#278440]/50 bg-white/90 dark:bg-[#0c1910]/90 px-3 py-1 shadow-sm mb-3">
        <img src="/images/lakera-logo-square.png" alt="La Kera Mascot Emblem" class="h-5 w-5 rounded-full object-cover border border-[#278440]" />
        <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#1e6933] dark:text-[#38b359]">Chef's Epicurean Showcase</span>
      </div>
      <h2 class="mt-3 font-serif text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-5xl lg:text-6xl">
        Legendary <span class="green-gradient-text italic font-normal">Signatures</span>
      </h2>
      <p class="mt-4 text-pretty text-zinc-600 dark:text-zinc-300 text-sm sm:text-base font-light">
        Four time-honored culinary gems that define the soul of La Kera. Prepared without haste using centuries-old coastal techniques.
      </p>
    </div>

    <!-- 2x2 Showcase Grid with Large Photography -->
    <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-2 lg:gap-10">
      {signatures.map((dish) => (
        <div class="card-luxury group overflow-hidden rounded-3xl transition-all duration-300 flex flex-col justify-between">
          <!-- Image Container with Zoom & Gradient Overlay -->
          <div class="relative h-64 sm:h-72 w-full overflow-hidden">
            <img
              src={dish.image}
              alt={dish.title}
              class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>

            <!-- Top Badge & Price Pill -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
              <span class="rounded-full border border-[#278440]/40 bg-white/90 dark:bg-[#060f09]/90 px-3.5 py-1 text-[11px] font-bold uppercase tracking-wider text-[#1e6933] dark:text-[#38b359] shadow-sm backdrop-blur-md">
                {dish.badge}
              </span>
              <span class="rounded-full bg-[#278440] px-3.5 py-1 text-xs font-bold text-white shadow-md shadow-[#278440]/40">
                ₹{dish.price}
              </span>
            </div>

            <!-- Subtitle on Image Overlay -->
            <div class="absolute bottom-3 left-5 right-5">
              <span class="text-xs font-semibold tracking-wide text-[#7bb0ff] uppercase">
                {dish.subtitle}
              </span>
              <h3 class="font-serif text-2xl font-bold text-white group-hover:text-[#38b359] transition-colors">
                {dish.title}
              </h3>
            </div>
          </div>

          <!-- Content Description & Tags -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-light">
                {dish.desc}
              </p>

              <!-- Tags with Brand Colors -->
              <div class="mt-4 flex flex-wrap gap-2">
                {dish.tags.map((tag) => (
                  <span class="rounded-md border border-zinc-200 dark:border-[#278440]/25 bg-zinc-100 dark:bg-[#0c1910] px-2.5 py-1 text-[11px] font-medium text-zinc-700 dark:text-zinc-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Action Button -->
            <div class="mt-6 pt-5 border-t border-zinc-200 dark:border-[#278440]/20 flex items-center justify-between">
              <span class="font-mono text-xl font-bold text-[#1e6933] dark:text-[#38b359]">
                ₹{dish.price}
              </span>

              <a
                href={getWhatsAppUrl(dish.orderText)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-[#278440]/30 dark:border-[#278440] bg-[#278440]/10 dark:bg-[#278440]/20 px-4 py-2.5 text-xs font-semibold text-[#1e6933] dark:text-[#38b359] transition-all hover:bg-[#278440] hover:text-white active:scale-95 shadow-sm"
              >
                <WhatsAppLogo class="h-3.5 w-3.5" />
                <span>Order via WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
