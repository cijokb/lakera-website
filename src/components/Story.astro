---
const pillars = [
  {
    title: "Daily Coastal Catch",
    description: "We work directly with artisanal coastal fishermen to source Pearl Spot (Karimeen), Tiger Prawns, and Seer Fish every morning—never frozen, always pristine.",
    tag: "Harbor Fresh",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`
  },
  {
    title: "Wood-Pressed Coconut Oil",
    description: "Every curry and roast is cooked in traditional cold-pressed Chekku coconut oil, imparting that unmistakable rich, nutty aroma central to genuine Malabar culinary heritage.",
    tag: "100% Pure",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />`
  },
  {
    title: "Stone-Ground Spice Blends",
    description: "Tellicherry black peppercorns, roasted coriander seeds, star anise, and whole cardamom are freshly ground on stone mills in small batches to preserve volatile essential oils.",
    tag: "Handcrafted",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`
  },
  {
    title: "Clay-Pot (Manchatti) Simmering",
    description: "Our signature meen curries and roasts are slow-simmered in seasoned earthen clay pots. The porous clay retains gentle moisture, letting curries mature in taste overnight.",
    tag: "Slow Food",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />`
  }
];
---

<section id="story" class="scroll-mt-20 py-16 sm:py-24 bg-zinc-900/30 border-t border-zinc-850">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl">
      <span class="text-xs font-semibold uppercase tracking-widest text-amber-500">Heirloom Tradition</span>
      <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
        Born on the Backwaters, Perfected in Every Pot
      </h2>
      <p class="mt-4 text-pretty text-zinc-300 text-sm sm:text-base leading-relaxed">
        At La Kera, our philosophy is anchored in age-old coastal hospitality. We don't take shortcuts with commercial gravies or artificial colors—we honor the authentic flavours of Malabar through traditional techniques and uncompromised ingredients.
      </p>
    </div>

    <!-- 4 Pillars Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((pillar) => (
        <div class="relative flex flex-col justify-between rounded-2xl border border-zinc-800 bg-zinc-900/80 p-6 backdrop-blur-sm transition-all hover:border-amber-500/40 hover:bg-zinc-900">
          <div>
            <div class="flex items-center justify-between">
              <span class="inline-flex rounded-lg bg-amber-500/10 p-2.5 text-amber-400">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={pillar.icon} />
              </span>
              <span class="rounded-md border border-zinc-700 bg-zinc-800 px-2 py-0.5 text-[10px] font-semibold text-zinc-300">
                {pillar.tag}
              </span>
            </div>

            <h3 class="mt-5 text-lg font-bold text-white">
              {pillar.title}
            </h3>

            <p class="mt-2 text-xs leading-relaxed text-zinc-400">
              {pillar.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Quote Banner -->
    <div class="mt-12 rounded-2xl border border-amber-500/20 bg-gradient-to-r from-amber-500/10 via-zinc-900 to-amber-500/5 p-6 sm:p-8">
      <blockquote class="text-center font-serif text-base italic text-zinc-200 sm:text-lg">
        "In Kerala, the hearth is sacred and cooking is an act of communion. Every meal at La Kera is prepared with the same devotion you would find at a Malabar family feast."
      </blockquote>
      <p class="mt-3 text-center text-xs font-semibold uppercase tracking-wider text-amber-400">
        — The La Kera Culinary Team
      </p>
    </div>
  </div>
</section>
