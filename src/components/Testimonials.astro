---
const testimonials = [
  {
    quote: "The Karimeen Pollichathu at La Kera is extraordinary. The shallot masala is slow-caramelized to perfection and the banana leaf smoke penetrates deep into the pearl spot flesh.",
    author: "Rohan Varma",
    role: "South Indian Culinary Journal",
    location: "Kochi",
    rating: 5
  },
  {
    quote: "True Thalassery dum biryani is becoming scarce, but La Kera executes it flawlessly. The aged Kaima rice is airy and glistening with pure ghee, perfectly spiced without overpowering.",
    author: "Ananya Menon",
    role: "Gastronomy Writer",
    location: "Bengaluru",
    rating: 5
  },
  {
    quote: "Eating the Alleppey Meen Curry simmered in their porous Manchatti clay pot transported me directly to childhood dinners in Kumarakom. Exceptional warmth and authenticity.",
    author: "Dr. Mathew Thomas",
    role: "Patron & Heritage Collector",
    location: "Chennai",
    rating: 5
  }
];
---

<section class="py-20 bg-[#f8faf8] dark:bg-[#060f09] border-t border-zinc-200 dark:border-[#278440]/25 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2">
        <span class="h-px w-8 bg-[#278440]/60"></span>
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#278440] dark:text-[#38b359]">Guest Acclaim</span>
        <span class="h-px w-8 bg-[#278440]/60"></span>
      </div>
      <h2 class="mt-3 font-serif text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl lg:text-5xl">
        Words from <span class="green-gradient-text italic font-normal">Our Diners</span>
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {testimonials.map((item) => (
        <div class="card-luxury rounded-3xl p-7 flex flex-col justify-between">
          <div>
            <!-- Star Rating -->
            <div class="flex items-center gap-1 text-[#cfa86e]">
              {Array.from({ length: item.rating }).map(() => (
                <span>★</span>
              ))}
            </div>

            <!-- Quote Text -->
            <p class="mt-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 font-light leading-relaxed italic">
              "{item.quote}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-[#278440]/20 flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-bold text-zinc-900 dark:text-white">
                {item.author}
              </p>
              <p class="text-[11px] font-medium text-[#24529a] dark:text-[#7bb0ff]">
                {item.role}
              </p>
            </div>
            <span class="text-[10px] uppercase font-semibold text-zinc-500 dark:text-zinc-400">
              {item.location}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
