---
import WhatsAppLogo from './icons/WhatsAppLogo.astro';

const floatWhatsAppUrl = `https://wa.me/919500978712?text=${encodeURIComponent(
  "Hello La Kera! I'd like to book a table / place an order."
)}`;
---

<div class="fixed bottom-6 right-6 z-50 group">
  <!-- Pulsing Glow Ring -->
  <span class="absolute -inset-1 rounded-full bg-[#278440]/50 blur-md group-hover:bg-[#278440]/70 animate-pulse"></span>

  <!-- Action Pill -->
  <a
    href={floatWhatsAppUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative inline-flex items-center gap-2.5 rounded-full border border-[#38b359]/60 bg-gradient-to-r from-[#278440] via-[#2f9c4d] to-[#1e6933] px-5 py-3 text-xs sm:text-sm font-bold tracking-wide text-white shadow-2xl shadow-[#278440]/50 transition-all duration-300 hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#278440] focus:ring-offset-2 focus:ring-offset-[#f8faf8] dark:focus:ring-offset-[#060f09]"
    aria-label="Reserve a table or order on WhatsApp (+91 95009 78712)"
  >
    <WhatsAppLogo class="h-5 w-5" />
    <span>WhatsApp Concierge</span>
  </a>
</div>
